# System Configuration
# ==========================================
ENVIRONMENT=production
LOG_LEVEL=INFO
TIMEZONE=UTC

# Scheduling
TRIGGER_TIME=23:00
# RETRAIN_DAY=sunday
# RETRAIN_TIME=02:00

# Model selection/config
MODEL_PATH=/app/models/eth_prediction_model
RETRAIN_FREQUENCY=14

# Model Configuration
# ==========================================
MODEL_NUM_CLASSES=3
MODEL_LABEL_STRATEGY=percentile
MODEL_DECISION_STRATEGY=median-split
MODEL_DECISION_THRESHOLD=0.6
MODEL_DECISION_TOP_K=2
MODEL_MEDIAN_LABEL_INVEST=false
PREDICTION_INTERVAL="1h"

# Investment Strategy Configuration
# ==========================================
STRATEGY_INVESTMENT_RATE=0.8
STRATEGY_STOP_LOSS_RATE=0.05

# Exchange credentials [TODO]
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_SANDBOX=true

# Ethereum Extraction Pipeline Configuration
# ==========================================

# Google Cloud Platform settings
GCP_PROJECT_ID=lgu-bot-462519
GCP_ZONE=us-central1-a
GCP_MACHINE_TYPE=e2-standard-2
GCP_BOOT_DISK_SIZE=10GB

# Required: Extraction repository (minimal VM code)
EXTRACTION_REPO=

# Required: Time range for extraction
INTERVAL_START=2021-01-01-00:00
INTERVAL_END=2022-05-01-23:59

# Required: VM deployment settings

NUM_VMS=5

# Optional: Extraction parameters
EXTRACTION_INTERVAL_UNIT=day
EXTRACTION_INTERVAL_LENGTH=1.0
EXTRACTION_OBSERVATIONS_PER_INTERVAL=100
EXTRACTION_PROVIDER_FETCH_DELAY_SECONDS=0.07

# Optional: Monitoring and storage
MONITOR_CHECK_INTERVAL=1200
